# Copy to .env (never commit .env to git)
# OpenRouter API key for Mission Diagnostics AI viability synthesis
OPENROUTER_API_KEY=

# Default uses OpenRouter's zero-cost capability-aware free router.
# Do NOT mix :free and paid models in fallback lists unless intentional.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=[]
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=35
OPENROUTER_SITE_URL=https://github.com/ckepi
OPENROUTER_APP_NAME=Ckepi Planetary Analogs
AI_RATE_LIMIT_PER_MIN=12
AI_CACHE_TTL_HOURS=168
